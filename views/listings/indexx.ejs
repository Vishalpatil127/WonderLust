<% layout("layouts/boilerplate") %>
<body>
    <h1>All Listings</h1>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-4">
      <% for(let listing of allListings){ %>
        <a href="/listings/<%= listing._id %>" class="listing-link" >
        <div class="col">
          <div class="card h-100">
            <img src="<%= listing.image %>" class="card-img-top" alt="listing image" style="height:20rem; object-fit: cover;" >
            <div class="card-body">
              <h5 class="card-title"><%= listing.title %></h5>
              <p class="card-text"><% if(listing.price) { %>&#8377; <%= listing.price.toLocaleString("en-IN") %> / night<% } else { %>Price not set<% } %></p>
            </div>
          </div>
        </div>
        </a>
      <% } %>
    </div>
</body>
