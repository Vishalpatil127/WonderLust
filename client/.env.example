# ── API ───────────────────────────────────────────────────────────────────────
# Full URL of the backend API (with /api suffix)
VITE_API_URL=https://api.wonderlust.com/api
# Base URL of the backend server (without /api) — used for OAuth redirect
VITE_API_BASE_URL=https://api.wonderlust.com

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Public key ID only — NEVER put the secret here
VITE_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Set to "true" to show the Google sign-in button (requires backend OAuth config)
VITE_GOOGLE_AUTH_ENABLED=true
