PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/wonderlust
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5174
NODE_ENV=development

# Google OAuth — get these from https://console.cloud.google.com/
# Authorized redirect URI must be: http://localhost:8080/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay — get these from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary — get these from https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
