# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/wonderlust

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-different-64-char-random-string

# ── URLs ──────────────────────────────────────────────────────────────────────
# Your deployed frontend URL (comma-separated for multiple origins)
CLIENT_URL=https://wonderlust.vercel.app
# Your deployed backend API URL (no trailing slash)
APP_URL=https://api.wonderlust.com
# OAuth callback — auto-derived from APP_URL if not set explicitly
# GOOGLE_CALLBACK_URL=https://api.wonderlust.com/api/oauth/google/callback

# ── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://api.wonderlust.com/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Razorpay ──────────────────────────────────────────────────────────────────
# https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Cloudinary ────────────────────────────────────────────────────────────────
# https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP (Gmail) ──────────────────────────────────────────────────────────────
# Use an App Password: myaccount.google.com → Security → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# ── Redis (optional — caching) ────────────────────────────────────────────────
# Leave blank to disable caching (app works without Redis)
REDIS_URL=redis://localhost:6379
